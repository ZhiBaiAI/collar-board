#!/usr/bin/env sh
# collar pre-commit — 提交关卡 ①②：结构门禁 + 质量门禁
#
# ① collar-check.sh：知识库结构完整性，失败直接拦截
# ② 质量门禁：读 collar.yaml validation.gates 中 kind: quality 的 cmd 逐个执行；
#    命令还是 ⟨占位符⟩ 的跳过（落地后填入真实命令即自动生效，无需改本脚本）
#
# 允许绕过：仅 WIP 与纯 typo 提交可用 --no-verify，且须在 message 写明原因（月度回顾列出）

set -u
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$ROOT" || exit 1

sh scripts/collar-check.sh || exit 1

CMDS=$(awk '
  /- name:/ {cmd=""}
  /cmd:/    {cmd=$0}
  /kind:/   { if ($0 ~ /quality/ && cmd != "") print cmd; cmd="" }
' collar.yaml 2>/dev/null | sed 's/.*cmd: *"\(.*\)".*/\1/; s/^ *//' | grep -v '⟨' || true)

[ -n "$CMDS" ] || exit 0

echo
echo "quality gates（collar.yaml kind: quality）"
while IFS= read -r CMD; do
  [ -n "$CMD" ] || continue
  echo "  run: $CMD"
  sh -c "$CMD" || { echo "FAIL 质量门禁未过：$CMD"; exit 1; }
done <<QGATES
$CMDS
QGATES
exit 0
